# Copy to .env (which is git-ignored) and fill in. Never commit .env.

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Notion internal integration secret: https://www.notion.so/profile/integrations
# Give it read/insert/update content capabilities.
NOTION_TOKEN=

# ID of a Notion page you shared with the integration (the "..." menu > Connections).
# The seeder creates its test fixtures underneath this page. Use a throwaway page.
NOTION_PARENT_PAGE_ID=

# Optional overrides
# BENCH_MODEL=claude-opus-5-5
# BENCH_EFFORT=medium
